# Local configuration for compose.yaml. Create .env with:  scripts/init_env.sh
# .env is git-ignored. Never commit real values.

POSTGRES_DB=jobmatcher
POSTGRES_USER=jobmatcher
POSTGRES_PASSWORD=change-me

# Encrypts the credentials stored in n8n (API keys, bot tokens).
# BACK IT UP OUTSIDE GIT (e.g. a password manager): without it, stored credentials
# cannot be decrypted after a reinstall. See infra/README.md.
N8N_ENCRYPTION_KEY=change-me

# Public base URL for webhooks (Telegram, MCP). Keep the default for local use.
N8N_WEBHOOK_URL=http://localhost:5678/
